# ─────────────────────────────────────────────────────────────────────────
# Nuvem MindsFlow — variáveis de ambiente
# Copie para .env.local (`cp .env.example .env.local`) e preencha.
# NUNCA comite o .env.local: ele fica de fora pelo .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# A URL e a anon key são públicas (vão para o navegador); a service_role NÃO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role: permissão total, ignora RLS. Só no servidor, nunca no cliente.
# Usada apenas por rotas administrativas (ex.: convites).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação — usada para montar o link de confirmação do
# e-mail de login. Em dev: http://localhost:3000
# Na Vercel: https://SEU-PROJETO.vercel.app (ou seu domínio próprio).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
