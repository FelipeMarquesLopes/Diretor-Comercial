# ==========================================================================
# Growth AI — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas chaves reais.
# NUNCA commite o .env.local (já está no .gitignore).
# ==========================================================================

# --- Supabase (banco de dados Postgres) -----------------------------------
# Crie um projeto grátis em https://supabase.com e pegue estes valores em
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Chave de serviço (service_role) — usada só no servidor (API routes).
# Tem permissão total: mantenha em segredo.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Anthropic (geração de rascunhos com IA) ------------------------------
# Pegue em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado para gerar as mensagens (padrão: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# --- Apollo.io (descoberta de empresas e contatos) ------------------------
# Precisa do plano Basic (o plano free NÃO libera busca de empresas/pessoas).
# Pegue em https://developer.apollo.io > API Keys
APOLLO_API_KEY=sua-apollo-api-key

# --- E-mail (enviar os e-mails com o clique do CEO) -----------------------
# Funciona com qualquer provedor SMTP (Titan, Gmail, etc.).
# Titan (HostGator):  host smtp.titan.email  porta 465
# Gmail:              host smtp.gmail.com    porta 465 (exige "senha de app")
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=felipe@clinicamenthalhelp.com.br
SMTP_PASSWORD=a-senha-do-email
# Nome que aparece como remetente:
SMTP_FROM_NAME=MenthalHelp

# --- Leitura automática das respostas (IMAP) ------------------------------
# O sistema lê a caixa de entrada deste mesmo e-mail para detectar respostas.
# Padrão: usa o mesmo SMTP_USER/SMTP_PASSWORD e troca "smtp." por "imap." no
# host. Só defina abaixo se o seu provedor usar outro host/porta.
IMAP_HOST=imap.titan.email
IMAP_PORT=993

# --- Acesso ao sistema (quando publicado) ---------------------------------
# Usuário e senha para entrar no sistema. Se deixar em branco, o app fica
# aberto (use só no seu computador durante o desenvolvimento).
APP_USER=felipe
APP_PASSWORD=troque-esta-senha

# --- Robô diário de follow-up (Vercel Cron) -------------------------------
# Um segredo qualquer (invente uma sequência longa). Protege o robô que roda
# sozinho todo dia. A Vercel usa isso automaticamente.
CRON_SECRET=invente-um-segredo-bem-longo-aqui

# --- Verificador de e-mail (deliverability) -------------------------------
# Antes de enviar para um e-mail que o Apollo só ADIVINHOU (não verificado),
# checamos se a caixa está ATIVA — sem enviar nada. Assim disparamos só para
# quem existe e não geramos retorno (bounce), que ameaça a reputação do
# domínio e a conta de envio (Titan/HostGator suspende).
# Escolha UM provedor, crie a conta e cole a chave:
#   zerobounce      -> https://www.zerobounce.net  (mais conhecido)
#   millionverifier -> https://www.millionverifier.com  (mais barato)
# Sem a chave, o sistema envia só para os já-verificados pelo Apollo.
EMAIL_VERIFIER_PROVIDER=zerobounce
EMAIL_VERIFIER_API_KEY=

# --- Trava de volume de envio (proteção da conta/reputação) ---------------
# Máximo de e-mails enviados em 24h. Acima disso, o envio é bloqueado (o
# rascunho fica pendente para depois). Ajuste conforme seu volume.
EMAIL_DAILY_CAP=50
